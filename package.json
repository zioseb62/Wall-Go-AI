{
  "name": "wall-go-ai",
  "private": true,
  "version": "2.21.06",
  "main": "dist/server.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "cap:init": "npx cap init \"Wall Go AI\" com.wallgo.ai.game --web-dir dist",
    "cap:add-android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open-android": "npx cap open android",
    "clean": "rimraf dist android/app/build",
    "generate-icons": "node generate-icons.cjs",
    "postinstall": "node generate-icons.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/device": "^8.0.2",
    "@google/genai": "^1.39.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "firebase": "^12.10.0",
    "framer-motion": "^12.40.0",
    "googleapis": "^171.4.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.41.0",
    "motion": "^12.40.0",
    "node-domexception": "^1.0.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "rimraf": "^5.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "protobufjs": "^7.6.6",
    "@grpc/grpc-js": "^1.14.6"
  }
}